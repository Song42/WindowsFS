<Window x:Class="WindowsFS.App.History.HistoryWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="WindowsFS · 용량 기록" Width="1080" Height="750" MinWidth="760" MinHeight="520" WindowStartupLocation="CenterOwner">
  <Grid Margin="24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
      <RowDefinition Height="135"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <DockPanel>
      <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right">
        <Button x:Name="DetailButton" Content="프로그램 추적" Click="DetailClick" Margin="0,0,8,0" ToolTip="Windows 권한 승인 후 실시간 쓰기·삭제 요청 관찰"/>
        <Button x:Name="TrackButton" Content="추적 시작" Click="TrackClick" Style="{StaticResource Primary}"/>
      </StackPanel>
      <TextBlock Text="용량 기록" FontSize="26" FontWeight="SemiBold"/>
    </DockPanel>
    <StackPanel Grid.Row="1" Margin="0,8,0,14">
      <TextBlock x:Name="StateText" Foreground="{StaticResource Accent}"/>
      <TextBlock x:Name="ScopeText" Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis"/>
    </StackPanel>
    <DockPanel Grid.Row="2">
      <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
        <Button x:Name="PeriodButton" Content="최근 24시간" Click="CyclePeriod" Margin="0,0,6,0"/>
        <Button x:Name="ResetButton" Content="시간 선택 해제" Click="ResetTime" Visibility="Collapsed"/>
      </StackPanel>
      <StackPanel><TextBlock Text="볼륨 전체 여유 공간" FontWeight="SemiBold"/>
        <TextBlock x:Name="VolumeText" Foreground="{StaticResource Muted}"/></StackPanel>
    </DockPanel>
    <Border Grid.Row="3" Background="{StaticResource Surface}" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,8">
      <DockPanel>
        <DockPanel DockPanel.Dock="Bottom">
          <TextBlock x:Name="EndLabel" DockPanel.Dock="Right" FontSize="10" Foreground="{StaticResource Muted}"/>
          <TextBlock x:Name="StartLabel" FontSize="10" Foreground="{StaticResource Muted}"/>
        </DockPanel>
        <Canvas x:Name="Plot" Background="Transparent" ClipToBounds="True" SizeChanged="PlotResized"
                MouseLeftButtonDown="PickTime" ToolTip="선택한 시각의 기록"/>
      </DockPanel>
    </Border>
    <DockPanel Grid.Row="4" Margin="0,4,0,8">
      <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
        <Button x:Name="ModeButton" Content="파일 변화" Click="CycleMode" Margin="0,0,6,0"/>
        <Button x:Name="SortButton" Content="최근순" Click="ToggleSort"/>
      </StackPanel>
      <StackPanel><TextBlock x:Name="TotalsText" FontWeight="SemiBold"/>
        <TextBlock x:Name="RangeText" FontSize="11" Foreground="{StaticResource Muted}"/></StackPanel>
    </DockPanel>
    <DataGrid x:Name="Groups" Grid.Row="5" SelectionChanged="GroupSelected" CanUserSortColumns="False">
      <DataGrid.Columns>
        <DataGridTextColumn Header="시각" Binding="{Binding When}" Width="115"/>
        <DataGridTextColumn Header="관찰된 프로그램" Binding="{Binding Program}" Width="1.3*"/>
        <DataGridTextColumn Header="작업" Binding="{Binding Action}" Width="*"/>
        <DataGridTextColumn Header="용도" Binding="{Binding Purpose}" Width="*"/>
        <DataGridTextColumn Header="파일" Binding="{Binding Count}" Width="55"/>
        <DataGridTextColumn Header="할당량 변화" Binding="{Binding Delta}" Width="100"/>
        <DataGridTextColumn Header="삭제 회수 추정" Binding="{Binding Freed}" Width="110"/>
      </DataGrid.Columns>
    </DataGrid>
    <Grid Grid.Row="6" Margin="0,8,0,0" x:Name="DetailArea" Visibility="Collapsed">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <DataGrid x:Name="Files" MaxHeight="132" MinHeight="64" SelectionChanged="FileSelected">
        <DataGrid.Columns>
          <DataGridTextColumn Header="파일 경로" Binding="{Binding Path}" Width="*"/>
          <DataGridTextColumn Header="할당량 변화" Binding="{Binding Delta}" Width="100"/>
          <DataGridTextColumn Header="삭제 회수 추정" Binding="{Binding Freed}" Width="110"/>
        </DataGrid.Columns>
      </DataGrid>
      <TextBlock Grid.Row="1" x:Name="FileText" Margin="2,7" TextWrapping="Wrap" MaxHeight="100" Foreground="{StaticResource Muted}"/>
    </Grid>
  </Grid>
</Window>
