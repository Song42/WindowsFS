<Window x:Class="WindowsFS.App.Controls.FolderPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource {x:Type Window}}" Title="분석할 폴더 선택"
        Width="760" Height="540" MinWidth="600" MinHeight="420"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" AllowDrop="False"
        Loaded="WindowLoaded" Closed="WindowClosed">
  <Grid Margin="22">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <TextBlock Text="폴더 탐색 · 읽기 전용" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,16" />
    <Grid Grid.Row="1" Margin="0,0,0,12">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <Button Content="↑" Command="{Binding UpCommand}" Padding="13,9" Margin="0,0,8,0" ToolTip="상위 폴더" AutomationProperties.Name="상위 폴더" />
      <TextBox x:Name="PathInputBox" Grid.Column="1" Text="{Binding PathInput, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsIdle}" AllowDrop="False" KeyDown="PathKeyDown" AutomationProperties.Name="폴더 경로" />
      <Button Grid.Column="2" Content="이동" Command="{Binding GoCommand}" Margin="8,0,0,0" Padding="15,9" />
    </Grid>
    <ItemsControl Grid.Row="2" ItemsSource="{Binding Drives}" Margin="0,0,0,10">
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate>
        <DataTemplate>
          <Button Content="{Binding}" Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Padding="12,6" Margin="0,0,6,4" FontSize="12" />
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
    <Border Grid.Row="3" Background="{StaticResource Surface}" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="8">
      <ListBox x:Name="FolderList" ItemsSource="{Binding Entries}" SelectedItem="{Binding SelectedEntry}" IsEnabled="{Binding IsIdle}"
               Background="Transparent" Foreground="{StaticResource Text}" BorderThickness="0" AllowDrop="False" ContextMenu="{x:Null}"
               ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto"
               ScrollViewer.CanContentScroll="True" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
               VirtualizingPanel.ScrollUnit="Pixel" MouseDoubleClick="FolderDoubleClick" KeyDown="FolderKeyDown" AutomationProperties.Name="하위 폴더 목록">
        <ListBox.ItemContainerStyle>
          <Style TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="ContextMenu" Value="{x:Null}" />
            <Setter Property="AllowDrop" Value="False" />
            <Setter Property="Template">
              <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                  <Border x:Name="Row" Background="Transparent" Padding="12,11" Margin="3,1" CornerRadius="5">
                    <ContentPresenter />
                  </Border>
                  <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Row" Property="Background" Value="#252A35" /></Trigger>
                    <Trigger Property="IsSelected" Value="True"><Setter TargetName="Row" Property="Background" Value="#39334D" /></Trigger>
                    <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Row" Property="BorderBrush" Value="{StaticResource Accent}" /><Setter TargetName="Row" Property="BorderThickness" Value="1" /></Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </Setter.Value>
            </Setter>
          </Style>
        </ListBox.ItemContainerStyle>
        <ListBox.ItemTemplate>
          <DataTemplate>
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
              <TextBlock Text="" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Foreground="{StaticResource Accent}" Margin="0,0,12,0" />
              <TextBlock Grid.Column="1" Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Path}" />
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </Border>
    <TextBlock Grid.Row="4" Text="{Binding Status}" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,9,0,12" />
    <Grid Grid.Row="5">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
      <TextBlock Text="{Binding SelectionPath}" ToolTip="{Binding SelectionPath}" TextTrimming="CharacterEllipsis" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,15,0" />
      <Button Grid.Column="1" Content="취소" IsCancel="True" Padding="19,9" Margin="0,0,8,0" />
      <Button x:Name="ConfirmFolderButton" Grid.Column="2" Content="선택" Click="ConfirmClick" IsEnabled="{Binding CanConfirm}" Style="{StaticResource Primary}" Padding="19,9" />
    </Grid>
  </Grid>
</Window>
