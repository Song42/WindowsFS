<Window x:Class="WindowsFS.App.Controls.FolderQuestionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="폴더 질문 · OpenAI" Style="{StaticResource {x:Type Window}}"
        Width="520" SizeToContent="Height" MinWidth="360" WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False" Loaded="OnLoaded" Closed="OnClosed">
  <Grid Margin="20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/><RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <TextBlock x:Name="FolderPath" TextWrapping="Wrap" FontWeight="SemiBold" FontSize="15"/>
    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,14">
      <RadioButton x:Name="DeleteChoice" Foreground="{StaticResource Text}" IsChecked="True" Checked="OnChoice"/>
      <RadioButton x:Name="PurposeChoice" Foreground="{StaticResource Text}" Margin="20,0,0,0" Checked="OnChoice"/>
    </StackPanel>
    <Border x:Name="AnswerPanel" Grid.Row="2" Style="{StaticResource Card}" Padding="12" Visibility="Collapsed">
      <ScrollViewer MaxHeight="320" VerticalScrollBarVisibility="Auto"><TextBlock x:Name="Body" TextWrapping="Wrap"/></ScrollViewer>
    </Border>
    <DockPanel Grid.Row="3" Margin="0,8,0,0">
      <Button x:Name="Send" DockPanel.Dock="Right" Content="OpenAI에 전송" Click="OnSend" IsEnabled="False"/>
      <TextBlock x:Name="Status" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,8,0"/>
    </DockPanel>
  </Grid>
</Window>
