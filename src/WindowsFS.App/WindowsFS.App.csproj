<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>WindowsFS</AssemblyName>
    <RootNamespace>WindowsFS.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>0.8.0</Version>
  </PropertyGroup>
  <ItemGroup>
    <Using Remove="System.Drawing;System.Windows.Forms" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.11" />
    <PackageReference Include="Microsoft.Diagnostics.Tracing.TraceEvent" Version="4.0.0" />
    <InternalsVisibleTo Include="WindowsFS.App.Tests" />
    <PackageReference Include="bblanchon.PDFium.Win32" Version="159.0.8152" />
    <PackageReference Include="MediaInfo.Core.Native" Version="26.10.0" />
    <Content Include="../../third-party/mediainfo/**/*" Link="third-party/mediainfo/%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../../third-party/pdfium/**/*" Link="third-party/pdfium/%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <ProjectReference Include="../WindowsFS.Core/WindowsFS.Core.csproj" />
  </ItemGroup>
</Project>
