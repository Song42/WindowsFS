<Window x:Class="WindowsFS.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework" xmlns:controls="clr-namespace:WindowsFS.App.Controls" Style="{StaticResource {x:Type Window}}" Title="WindowsFS · 저장 공간 분석" Width="1440" Height="920" MinWidth="1100" MinHeight="760" WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize" Loaded="WindowLoaded" Closing="WindowClosing">
  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="42" ResizeBorderThickness="6" CornerRadius="0" GlassFrameThickness="0" />
  </shell:WindowChrome.WindowChrome>
  <Window.InputBindings>
    <KeyBinding Key="F5" Command="{Binding ScanCommand}" />
    <KeyBinding Key="Escape" Command="{Binding CancelCommand}" />
  </Window.InputBindings>
  <Border BorderBrush="#343846" BorderThickness="1">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="42" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="216" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Border Grid.ColumnSpan="2" Background="#101218">
        <Grid>
          <StackPanel Orientation="Horizontal" Margin="22,0" VerticalAlignment="Center">
            <TextBlock Text="◈" Foreground="{StaticResource Accent}" FontSize="20" Margin="0,0,10,0" />
            <TextBlock Text="WindowsFS" FontWeight="SemiBold" VerticalAlignment="Center" />
            <TextBlock Text=" /  STORAGE EXPLORER" Foreground="#727A8D" FontSize="10" Margin="10,0,0,0" VerticalAlignment="Center" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" shell:WindowChrome.IsHitTestVisibleInChrome="True">
            <Button Content="─" Width="46" Padding="0" Style="{StaticResource Nav}" Click="MinimizeClick" AutomationProperties.Name="최소화" />
            <Button Content="□" Width="46" Padding="0" Style="{StaticResource Nav}" Click="MaximizeClick" AutomationProperties.Name="최대화 또는 복원" />
            <Button Content="✕" Width="46" Padding="0" Style="{StaticResource Nav}" Click="CloseClick" AutomationProperties.Name="닫기" />
          </StackPanel>
        </Grid>
      </Border>
      <Border Grid.Row="1" Background="#15171E" BorderBrush="#262A35" BorderThickness="0,0,1,0">
        <Grid Margin="14,26,14,20">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <StackPanel Margin="12,0,0,26">
            <TextBlock Text="내 PC의 공간," FontSize="20" FontWeight="SemiBold" />
            <TextBlock Text="더 명확하게." FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource Accent}" Margin="0,3,0,0" />
          </StackPanel>
          <StackPanel Grid.Row="1">
            <TextBlock Text="WORKSPACE" FontSize="10" Foreground="#6E7789" Margin="16,0,0,9" />
            <Button Command="{Binding NavigateCommand}" CommandParameter="overview" Tag="{Binding IsOverview}" Style="{StaticResource Nav}">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Margin="0,0,12,0" />
                <TextBlock Text="공간 분석" />
              </StackPanel>
            </Button>
            <Button Command="{Binding NavigateCommand}" CommandParameter="files" Tag="{Binding IsFiles}" Style="{StaticResource Nav}">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Margin="0,0,12,0" />
                <TextBlock Text="가장 큰 파일" />
              </StackPanel>
            </Button>
            <Button Command="{Binding NavigateCommand}" CommandParameter="folders" Tag="{Binding IsFolders}" Style="{StaticResource Nav}">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Margin="0,0,12,0" />
                <TextBlock Text="폴더 탐색" />
              </StackPanel>
            </Button>
            <Button Command="{Binding NavigateCommand}" CommandParameter="types" Tag="{Binding IsTypes}" Style="{StaticResource Nav}">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Margin="0,0,12,0" />
                <TextBlock Text="파일 형식" />
              </StackPanel>
            </Button>
          </StackPanel>
          <StackPanel Grid.Row="2" Margin="0,34,0,0">
            <TextBlock Text="CONNECTED DRIVES" FontSize="10" Foreground="#6E7789" Margin="16,0,0,9" />
            <Button Content="모든 로컬 드라이브" Command="{Binding SelectDriveCommand}" Tag="{Binding IsAllDrivesSelected}" Style="{StaticResource Nav}" Foreground="{StaticResource Accent}" />
          </StackPanel>
          <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{Binding Drives}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Button Command="{Binding DataContext.SelectDriveCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding Path}" Tag="{Binding IsSelected}" Style="{StaticResource Nav}" Padding="12,13" Margin="0,4">
                    <StackPanel Width="154">
                      <TextBlock Text="{Binding Label}" FontSize="12" TextTrimming="CharacterEllipsis" ToolTip="{Binding Label}" />
                      <ProgressBar Value="{Binding UsedPercent, Mode=OneWay}" Height="3" Background="#303442" Foreground="#9C8DCD" BorderThickness="0" Margin="0,10,0,9" />
                      <TextBlock Text="{Binding Capacity}" FontSize="10" Foreground="{StaticResource Muted}" TextWrapping="Wrap" />
                    </StackPanel>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
          <Border Grid.Row="4" Background="#20232D" CornerRadius="9" Padding="13" Margin="0,20,0,0">
            <StackPanel>
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Foreground="#9ED4BE" Margin="0,0,8,0" />
                <TextBlock Text="로컬에서만, 안전하게" FontSize="11" Foreground="#B4D7C9" />
              </StackPanel>
              <TextBlock Text="파일 내용은 읽지 않습니다.&#xA;결과는 이 PC에 저장합니다." Foreground="{StaticResource Muted}" FontSize="10" LineHeight="17" Margin="0,9,0,0" />
            </StackPanel>
          </Border>
        </Grid>
      </Border>
      <Grid Grid.Row="1" Grid.Column="1" Margin="30,26,30,18">
        <Grid.RowDefinitions>
          <RowDefinition Height="76" />
          <RowDefinition Height="78" />
          <RowDefinition Height="124" />
          <RowDefinition Height="*" />
          <RowDefinition Height="64" />
        </Grid.RowDefinitions>
        <Grid>
          <StackPanel>
            <TextBlock Text="{Binding PageTitle}" FontSize="30" FontWeight="SemiBold" />
            <TextBlock Text="{Binding PageDescription}" Foreground="{StaticResource Muted}" Margin="0,7,0,0" />
          </StackPanel>
          <Border HorizontalAlignment="Right" VerticalAlignment="Top" Background="#252333" BorderBrush="#413952" BorderThickness="1" CornerRadius="14" Padding="12,6">
            <StackPanel Orientation="Horizontal">
              <Ellipse Width="6" Height="6" Fill="#B4A2EA" Margin="0,0,8,0" />
              <TextBlock Text="{Binding ScanState}" Foreground="{StaticResource Accent}" FontSize="11" />
            </StackPanel>
          </Border>
        </Grid>
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="16,12" Margin="0,0,0,12">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center" Margin="0,0,15,0">
              <TextBlock Text="분석 대상" FontSize="10" Foreground="{StaticResource Muted}" />
              <TextBlock Text="{Binding TargetLabel}" FontWeight="SemiBold" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding TargetLabel}" />
            </StackPanel>
            <Button Grid.Column="1" Content="폴더 선택" Command="{Binding ChooseFolderCommand}" Margin="0,0,10,0" VerticalAlignment="Center" />
            <Grid Grid.Column="2">
              <Button Content="{Binding ScanLabel}" Command="{Binding ScanCommand}" Style="{StaticResource Primary}" MinWidth="116" VerticalAlignment="Center" Visibility="{Binding IsIdle, Converter={StaticResource Visible}}" ToolTip="F5" />
              <Button Content="분석 중지" Command="{Binding CancelCommand}" Background="#4B303A" BorderBrush="#6D424B" MinWidth="116" VerticalAlignment="Center" Visibility="{Binding IsBusy, Converter={StaticResource Visible}}" ToolTip="Esc · 현재까지의 결과를 보관합니다." />
            </Grid>
          </Grid>
        </Border>
        <UniformGrid Grid.Row="2" Columns="4" Margin="0,0,0,18">
          <Border Style="{StaticResource Card}" Margin="0,0,12,0" Padding="18,14">
            <StackPanel>
              <TextBlock Text="분석된 파일 크기" Foreground="{StaticResource Muted}" FontSize="11" />
              <TextBlock Text="{Binding TotalSize}" FontSize="27" FontWeight="SemiBold" Foreground="{StaticResource Accent}" Margin="0,5,0,0" />
              <TextBlock Text="논리적 크기 · 1 KB = 1,024 B" FontSize="9" Foreground="#768094" Margin="0,2,0,0" />
            </StackPanel>
          </Border>
          <Border Style="{StaticResource Card}" Margin="0,0,12,0" Padding="18,14">
            <StackPanel>
              <TextBlock Text="확인한 파일" Foreground="{StaticResource Muted}" FontSize="11" />
              <TextBlock Text="{Binding FileCount}" FontSize="27" FontWeight="SemiBold" Margin="0,5,0,0" />
              <TextBlock Text="{Binding FolderCount}" FontSize="10" Foreground="#768094" Margin="0,2,0,0" />
            </StackPanel>
          </Border>
          <Border Style="{StaticResource Card}" Margin="0,0,12,0" Padding="18,14">
            <StackPanel>
              <TextBlock Text="분석 시간" Foreground="{StaticResource Muted}" FontSize="11" />
              <TextBlock Text="{Binding Elapsed}" FontSize="27" FontWeight="SemiBold" Margin="0,5,0,0" />
              <TextBlock Text="{Binding Speed}" FontSize="10" Foreground="#768094" Margin="0,2,0,0" />
            </StackPanel>
          </Border>
          <Border Style="{StaticResource Card}" Padding="18,14" ToolTip="접근 권한이 없거나 링크, 오프라인 파일인 항목을 건너뜁니다. 제외된 폴더 안의 파일 수는 알 수 없습니다.">
            <StackPanel>
              <TextBlock Text="건너뛴 항목" Foreground="{StaticResource Muted}" FontSize="11" />
              <TextBlock Text="{Binding Skipped}" FontSize="27" FontWeight="SemiBold" Margin="0,5,0,0" />
              <TextBlock Text="권한 제한 / 링크 / 오프라인" FontSize="10" Foreground="#768094" Margin="0,2,0,0" />
            </StackPanel>
          </Border>
        </UniformGrid>
        <Grid Grid.Row="3">
          <Grid Visibility="{Binding HasResult, Converter={StaticResource Visible}}">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <StackPanel Margin="0,0,0,12">
              <TextBlock Text="{Binding ResultScope}" TextTrimming="CharacterEllipsis" ToolTip="{Binding ResultScope}" Foreground="{StaticResource Muted}" FontSize="10" Margin="0,0,0,4" />
              <TextBlock Text="{Binding SnapshotDescription}" TextTrimming="CharacterEllipsis" ToolTip="{Binding SnapshotDescription}" Foreground="{StaticResource Accent}" FontSize="10" Margin="0,0,0,8" />
              <DockPanel Visibility="{Binding ShowFolderNavigation, Converter={StaticResource Visible}}">
                <Button Content="↑" Command="{Binding UpCommand}" Padding="12,6" ToolTip="상위 폴더" />
                <Button Content="전체" Command="{Binding HomeCommand}" Padding="12,6" Margin="7,0,12,0" />
                <TextBlock Text="{Binding Breadcrumb}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Foreground="{StaticResource Muted}" ToolTip="{Binding Breadcrumb}" />
              </DockPanel>
            </StackPanel>
            <Grid Grid.Row="1">
              <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="MapColumn" Width="0.85*" />
                <ColumnDefinition Width="1.4*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <Border Grid.Column="0" Style="{StaticResource Card}" Padding="16" Margin="0,0,16,0" Visibility="{Binding IsMapVisible, Converter={StaticResource Visible}}">
                <Grid>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                  </Grid.RowDefinitions>
                  <StackPanel Margin="0,0,0,16">
                    <TextBlock Text="{Binding MapTitle}" FontSize="15" FontWeight="SemiBold" />
                    <TextBlock Text="크기가 클수록 더 많은 공간 · 클릭하여 탐색" Foreground="{StaticResource Muted}" FontSize="10" Margin="0,6,0,0" />
                  </StackPanel>
                  <controls:SpaceMap Grid.Row="1" Items="{Binding MapItems}" ItemInvoked="MapItemInvoked" MinHeight="140" />
                  <TextBlock Grid.Row="2" Text="폴더별 합산 크기 · 0 B 항목은 지도에서 제외" Foreground="#768094" FontSize="10" Margin="0,13,0,0" />
                </Grid>
              </Border>
              <Border Grid.Column="1" Style="{StaticResource Card}" Padding="0" ClipToBounds="True">
                <Grid>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                  </Grid.RowDefinitions>
                  <Grid Margin="18,16,18,12">
                    <StackPanel>
                      <TextBlock Text="{Binding TableTitle}" FontWeight="SemiBold" FontSize="15" />
                      <TextBlock Text="{Binding TableHint}" Foreground="{StaticResource Muted}" FontSize="10" Margin="0,5,0,0" />
                    </StackPanel>
                    <TextBlock Text="{Binding ResultCount}" HorizontalAlignment="Right" VerticalAlignment="Top" Foreground="{StaticResource Muted}" FontSize="11" />
                  </Grid>
                  <TextBox Grid.Row="1" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged, Delay=180}" Margin="16,0,16,12" AutomationProperties.Name="결과 검색" ToolTip="현재 목록에서 이름 또는 경로를 검색합니다.">
                    <TextBox.Style>
                      <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                        <Style.Triggers>
                          <Trigger Property="Text" Value="">
                            <Setter Property="Background">
                              <Setter.Value>
                                <VisualBrush AlignmentX="Left" AlignmentY="Center" Stretch="None">
                                  <VisualBrush.Visual>
                                    <TextBlock Text="   이름 또는 경로 검색…" Foreground="#727B8F" FontSize="12" />
                                  </VisualBrush.Visual>
                                </VisualBrush>
                              </Setter.Value>
                            </Setter>
                          </Trigger>
                        </Style.Triggers>
                      </Style>
                    </TextBox.Style>
                  </TextBox>
                  <Grid Grid.Row="2">
                    <DataGrid x:Name="ResultsGrid" ItemsSource="{Binding Rows}" SelectedItem="{Binding SelectedRow}" MouseDoubleClick="ResultsDoubleClick" KeyDown="ResultsKeyDown" AutomationProperties.Name="분석 결과 목록">
                      <DataGrid.Columns>
                        <DataGridTemplateColumn Header="이름" Width="*" SortMemberPath="Name">
                          <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                              <Grid>
                                <Grid.ColumnDefinitions>
                                  <ColumnDefinition Width="30" />
                                  <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Glyph}" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Foreground="#B9AAEC" FontSize="17" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                  <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" FontSize="12" ToolTip="{Binding Name}" />
                                  <TextBlock Text="{Binding Path}" Foreground="#808A9F" FontSize="10" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding Path}" />
                                </StackPanel>
                              </Grid>
                            </DataTemplate>
                          </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="크기" Binding="{Binding Size}" SortMemberPath="Bytes" Width="105" />
                        <DataGridTemplateColumn Header="전체 비율" Width="92" SortMemberPath="Share">
                          <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                              <StackPanel>
                                <TextBlock Text="{Binding ShareText}" FontSize="11" Foreground="#B7BECC" />
                                <ProgressBar Value="{Binding Share, Mode=OneWay}" Height="3" Foreground="#B29DDD" Background="#333746" BorderThickness="0" Margin="0,6,0,0" />
                              </StackPanel>
                            </DataTemplate>
                          </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                      </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock Text="표시할 항목이 없습니다." Foreground="{StaticResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding NoRows, Converter={StaticResource Visible}}" IsHitTestVisible="False" />
                  </Grid>
                  <Border Grid.Row="3" BorderBrush="{StaticResource Border}" BorderThickness="0,1,0,0" Padding="12,10">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                      <Button Content="시스템 설명" Command="{Binding ShowSystemInfoCommand}" Visibility="{Binding CanShowSystemInfo, Converter={StaticResource Visible}}" Padding="11,7" FontSize="11" Margin="0,0,8,0" />
                      <Button Content="경로 복사" Command="{Binding CopyPathCommand}" Padding="11,7" FontSize="11" Margin="0,0,8,0" />
                      <Button Content="탐색기에서 보기 ↗" Command="{Binding RevealCommand}" Padding="11,7" FontSize="11" />
                    </StackPanel>
                  </Border>
                </Grid>
              </Border>
              <Border x:Name="SystemInfoPanel" Grid.Column="2" Style="{StaticResource Card}" Width="326" Margin="16,0,0,0" Padding="18" Visibility="{Binding HasSystemInfo, Converter={StaticResource Visible}}">
                <Grid>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                  </Grid.RowDefinitions>
                  <Grid Margin="0,0,0,15">
                    <StackPanel>
                      <TextBlock Text="SYSTEM INSIGHT" Foreground="{StaticResource Accent}" FontSize="10" />
                      <TextBlock Text="시스템 항목 안내" FontSize="17" FontWeight="SemiBold" Margin="0,6,0,0" />
                    </StackPanel>
                    <Button Content="✕" Command="{Binding DismissSystemInfoCommand}" HorizontalAlignment="Right" VerticalAlignment="Top" Padding="7,3" Background="Transparent" BorderThickness="0" AutomationProperties.Name="시스템 설명 닫기" />
                  </Grid>
                  <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="0,0,8,0">
                      <TextBlock Text="{Binding SystemInfo.Title}" TextWrapping="Wrap" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource Accent}" />
                      <TextBlock Text="무슨 용도인가요?" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,18,0,5" />
                      <TextBlock Text="{Binding SystemInfo.Purpose}" TextWrapping="Wrap" FontSize="12" LineHeight="20" />
                      <TextBlock Text="관리 주체" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,17,0,5" />
                      <TextBlock Text="{Binding SystemInfo.ManagedBy}" TextWrapping="Wrap" FontSize="12" LineHeight="20" />
                      <TextBlock Text="꼭 필요한가요?" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,17,0,5" />
                      <TextBlock Text="{Binding SystemInfo.Necessity}" TextWrapping="Wrap" FontSize="12" LineHeight="20" />
                      <TextBlock Text="공간을 줄이려면" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,17,0,5" />
                      <TextBlock Text="{Binding SystemInfo.CleanupAdvice}" TextWrapping="Wrap" FontSize="12" LineHeight="20" />
                      <Border Background="#252333" CornerRadius="7" Padding="10" Margin="0,18,0,0">
                        <TextBlock Text="{Binding SystemInfo.MatchBasis}" TextWrapping="Wrap" Foreground="{StaticResource Muted}" FontSize="10" LineHeight="17" />
                      </Border>
                    </StackPanel>
                  </ScrollViewer>
                  <Button Grid.Row="2" Content="Microsoft 공식 설명 ↗" Command="{Binding OpenSystemHelpCommand}" Margin="0,15,0,0" Padding="12,9" FontSize="11" />
                </Grid>
              </Border>
            </Grid>
          </Grid>
          <Border Style="{StaticResource Card}" Visibility="{Binding ShowEmpty, Converter={StaticResource Visible}}" Background="#171A22">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.3*" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <StackPanel VerticalAlignment="Center" Margin="32,0,20,0">
                <TextBlock Text="A LITTLE CLARITY. A LOT OF SPACE." Foreground="#AC99DD" FontSize="10" Margin="0,0,0,22" />
                <TextBlock Text="공간을 차지하는 파일,&#xA;이제 쉽게 찾아보세요." FontSize="29" FontWeight="SemiBold" LineHeight="43" />
                <TextBlock Text="드라이브 전체 또는 원하는 폴더를 분석하고,&#xA;큰 파일부터 폴더 구성까지 한눈에 확인하세요." Foreground="{StaticResource Muted}" FontSize="13" LineHeight="23" Margin="0,18,0,0" />
                <TextBlock Text="01  대상 선택     02  분석 시작     03  공간 확인" Foreground="#B3B9C7" FontSize="11" Margin="0,30,0,0" />
              </StackPanel>
              <Grid Grid.Column="1" Width="250" Height="250" VerticalAlignment="Center" HorizontalAlignment="Center" Opacity="0.9" IsHitTestVisible="False">
                <Grid.RowDefinitions>
                  <RowDefinition Height="1.2*" />
                  <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="1.3*" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Background="#B7A5F5" CornerRadius="10" Margin="4">
                  <TextBlock Text="" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Foreground="#3B3158" FontSize="38" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <Border Grid.Column="1" Background="#7199CA" CornerRadius="10" Margin="4" />
                <Border Grid.Row="1" Background="#68AFA2" CornerRadius="10" Margin="4" />
                <Grid Grid.Row="1" Grid.Column="1">
                  <Grid.RowDefinitions>
                    <RowDefinition />
                    <RowDefinition />
                  </Grid.RowDefinitions>
                  <Border Background="#CF9A87" CornerRadius="10" Margin="4" />
                  <Border Grid.Row="1" Background="#57516C" CornerRadius="10" Margin="4" />
                </Grid>
              </Grid>
            </Grid>
          </Border>
        </Grid>
        <Grid Grid.Row="4" Margin="0,13,0,0">
          <Grid.RowDefinitions>
            <RowDefinition Height="3" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <ProgressBar Height="2" IsIndeterminate="{Binding IsBusy}" Visibility="{Binding IsBusy, Converter={StaticResource Visible}}" Foreground="{StaticResource Accent}" Background="#282331" BorderThickness="0" />
          <StackPanel Grid.Row="1" VerticalAlignment="Center">
            <TextBlock Text="{Binding Status}" FontSize="11" Foreground="#C0C6D2" />
            <TextBlock Text="{Binding CurrentPath}" FontSize="10" Foreground="#7D879B" Margin="0,5,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding CurrentPath}" />
          </StackPanel>
        </Grid>
      </Grid>
    </Grid>
  </Border>
</Window>
