<Window x:Class="WindowsFS.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework" xmlns:controls="clr-namespace:WindowsFS.App.Controls" Style="{StaticResource {x:Type Window}}" Title="WindowsFS · 저장 공간 분석" Width="1440" Height="920" MinWidth="1100" MinHeight="760" WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize" Loaded="WindowLoaded" Closing="WindowClosing">
  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="42" ResizeBorderThickness="6" CornerRadius="0" GlassFrameThickness="0" />
  </shell:WindowChrome.WindowChrome>
  <Window.Resources>
    <controls:SpaceMapVisibilityConverter x:Key="SpaceMapVisibility" />
  </Window.Resources>
  <Window.InputBindings>
    <KeyBinding Key="F5" Command="{Binding ScanCommand}" />
    <KeyBinding Key="Escape" Command="{Binding CancelCommand}" />
  </Window.InputBindings>
  <Border BorderBrush="#343846" BorderThickness="1">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="42" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>
      <Border Background="#101218">
        <Grid>
          <StackPanel Orientation="Horizontal" Margin="30,0" VerticalAlignment="Center">
            <TextBlock Text="◈" Foreground="{StaticResource Accent}" FontSize="20" Margin="0,0,10,0" />
            <TextBlock Text="WindowsFS" FontWeight="SemiBold" VerticalAlignment="Center" />
            <Border Width="1" Height="16" Background="{StaticResource Border}" Margin="22,0,12,0" Visibility="{Binding IsDetailView, Converter={StaticResource Visible}}" />
            <Button x:Name="DashboardBackButton" Content="← 대시보드" Command="{Binding NavigateCommand}" CommandParameter="overview" Visibility="{Binding IsDetailView, Converter={StaticResource Visible}}" Padding="10,5" Margin="0" FontSize="12" Style="{StaticResource Nav}" Foreground="{StaticResource Muted}" shell:WindowChrome.IsHitTestVisibleInChrome="True" AutomationProperties.Name="대시보드로 돌아가기" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" shell:WindowChrome.IsHitTestVisibleInChrome="True">
            <Button Content="─" Width="46" Padding="0" Style="{StaticResource Nav}" Click="MinimizeClick" AutomationProperties.Name="최소화" />
            <Button Content="□" Width="46" Padding="0" Style="{StaticResource Nav}" Click="MaximizeClick" AutomationProperties.Name="최대화 또는 복원" />
            <Button Content="✕" Width="46" Padding="0" Style="{StaticResource Nav}" Click="CloseClick" AutomationProperties.Name="닫기" />
          </StackPanel>
        </Grid>
      </Border>
      <Grid x:Name="MainContent" Grid.Row="1" Margin="30,22,30,18">
        <Grid.RowDefinitions>
          <RowDefinition Height="58" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel>
            <TextBlock x:Name="PageTitleText" Text="{Binding PageTitle}" FontSize="28" FontWeight="SemiBold" />
            <TextBlock Text="{Binding PageDescription}" FontSize="12" Foreground="{StaticResource Muted}" Margin="0,4,0,0" Visibility="{Binding ShowPageDescription, Converter={StaticResource Visible}}" />
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top" Margin="16,3,0,0">
            <Button x:Name="DeleteSavedAnalysisButton" Content="저장된 분석 삭제" Command="{Binding DeleteSavedAnalysisCommand}" Margin="0,0,12,0" Padding="12,7" FontSize="11" Background="Transparent" Foreground="{StaticResource Muted}" ToolTip="저장된 분석·현재 결과 삭제 · 실제 파일·폴더 유지" />
            <Border Background="#252333" BorderBrush="#413952" BorderThickness="1" CornerRadius="14" Padding="12,6">
              <StackPanel Orientation="Horizontal">
                <Ellipse Width="6" Height="6" Fill="#B4A2EA" Margin="0,0,8,0" />
                <TextBlock Text="{Binding ScanState}" Foreground="{StaticResource Accent}" FontSize="11" VerticalAlignment="Center" />
              </StackPanel>
            </Border>
          </StackPanel>
        </Grid>
        <Border x:Name="ScanControls" Grid.Row="1" Style="{StaticResource Card}" Height="52" Padding="16,5" Margin="0,0,0,10" Visibility="{Binding ShowScanControls, Converter={StaticResource Visible}}">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center" Margin="0,0,15,0">
              <TextBlock Text="분석 대상" FontSize="10" Foreground="{StaticResource Muted}" />
              <TextBlock Text="{Binding TargetLabel}" FontWeight="SemiBold" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding TargetLabel}" />
            </StackPanel>
            <Button Grid.Column="1" Content="폴더 선택" Command="{Binding ChooseFolderCommand}" Margin="0,0,10,0" VerticalAlignment="Center" />
            <Grid Grid.Column="2">
              <Button Content="{Binding ScanLabel}" Command="{Binding ScanCommand}" Style="{StaticResource Primary}" MinWidth="116" VerticalAlignment="Center" Visibility="{Binding IsIdle, Converter={StaticResource Visible}}" ToolTip="F5" />
              <Button Content="분석 중지" Command="{Binding CancelCommand}" Background="#4B303A" BorderBrush="#6D424B" MinWidth="116" VerticalAlignment="Center" Visibility="{Binding IsBusy, Converter={StaticResource Visible}}" ToolTip="Esc · 부분 결과 유지" />
            </Grid>
          </Grid>
        </Border>
        <StackPanel x:Name="DashboardNavigation" Grid.Row="2" Visibility="{Binding IsOverview, Converter={StaticResource Visible}}">
          <UniformGrid x:Name="DashboardCards" Columns="4" Height="74" Margin="0,0,0,8">
            <Button x:Name="DashboardFilesButton" Command="{Binding NavigateCommand}" CommandParameter="files" Style="{StaticResource DashboardLink}" Margin="0,0,12,0" AutomationProperties.Name="가장 큰 파일">
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <TextBlock Text="" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="20" Foreground="{StaticResource Accent}" Margin="0,0,14,0" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                  <TextBlock Text="가장 큰 파일" FontSize="15" FontWeight="SemiBold" />
                </StackPanel>
                <StackPanel Grid.Column="2" HorizontalAlignment="Right" Margin="8,0,0,0">
                  <TextBlock Text="→" Foreground="{StaticResource Accent}" FontSize="15" HorizontalAlignment="Right" />
                  <TextBlock Text="{Binding LargestFileCount}" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,6,0,0" />
                </StackPanel>
              </Grid>
            </Button>
            <Button x:Name="DashboardFoldersButton" Command="{Binding NavigateCommand}" CommandParameter="folders" Style="{StaticResource DashboardLink}" Margin="0,0,12,0" AutomationProperties.Name="폴더 탐색">
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <TextBlock Text="" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="20" Foreground="#82B1E7" Margin="0,0,14,0" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1">
                  <TextBlock Text="폴더 탐색" FontSize="15" FontWeight="SemiBold" />
                  <TextBlock Text="폴더별 누적 용량" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,6,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="2" HorizontalAlignment="Right" Margin="8,0,0,0">
                  <TextBlock Text="→" Foreground="#82B1E7" FontSize="15" HorizontalAlignment="Right" />
                  <TextBlock Text="{Binding FolderCount}" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,6,0,0" />
                </StackPanel>
              </Grid>
            </Button>
            <Button x:Name="DashboardTypesButton" Command="{Binding NavigateCommand}" CommandParameter="types" Style="{StaticResource DashboardLink}" Margin="0,0,12,0" AutomationProperties.Name="파일 형식">
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <TextBlock Text="" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="20" Foreground="#70BEB1" Margin="0,0,14,0" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1">
                  <TextBlock Text="파일 형식" FontSize="15" FontWeight="SemiBold" />
                  <TextBlock Text="확장자별 용량 합계" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,6,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="2" HorizontalAlignment="Right" Margin="8,0,0,0">
                  <TextBlock Text="→" Foreground="#70BEB1" FontSize="15" HorizontalAlignment="Right" />
                  <TextBlock Text="{Binding FileTypeCount}" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,6,0,0" />
                </StackPanel>
              </Grid>
            </Button>
            <Button x:Name="DashboardCleanupButton" Command="{Binding NavigateCommand}" CommandParameter="cleanup" Style="{StaticResource DashboardLink}" AutomationProperties.Name="정리 분석">
              <StackPanel>
                <TextBlock Text="정리 분석 →" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource Accent}" />
                <TextBlock Text="앱·용도별 묶음" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,6,0,0" />
              </StackPanel>
            </Button>
          </UniformGrid>
          <Grid x:Name="DashboardStatistics" Height="26" Margin="2,0,2,8">
            <Grid.ColumnDefinitions><ColumnDefinition Width="1.2*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" ToolTip="논리적 크기 · 1 KB = 1,024 B">
              <TextBlock Text="분석된 파일 크기" Foreground="{StaticResource Muted}" FontSize="11" VerticalAlignment="Center" />
              <TextBlock Text="{Binding TotalSize}" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource Accent}" Margin="12,0,0,0" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
              <TextBlock Text="확인한 파일" Foreground="{StaticResource Muted}" FontSize="11" VerticalAlignment="Center" />
              <TextBlock Text="{Binding FileCount}" FontSize="13" FontWeight="SemiBold" Margin="10,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" ToolTip="{Binding Speed}">
              <TextBlock Text="분석 시간" Foreground="{StaticResource Muted}" FontSize="11" VerticalAlignment="Center" />
              <TextBlock Text="{Binding Elapsed}" FontSize="13" FontWeight="SemiBold" Margin="10,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
            <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" ToolTip="권한 제한·링크·오프라인 항목 제외. 제외된 폴더의 하위 파일 수 미집계.">
              <TextBlock Text="건너뛴 항목" Foreground="{StaticResource Muted}" FontSize="11" VerticalAlignment="Center" />
              <TextBlock Text="{Binding Skipped}" FontSize="13" FontWeight="SemiBold" Margin="10,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
          </Grid>
        </StackPanel>
        <Grid x:Name="AnalysisResults" Grid.Row="3">
          <Grid Visibility="{Binding HasResult, Converter={StaticResource Visible}}">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <StackPanel Margin="0,0,0,8" Visibility="{Binding ShowStandardResults, Converter={StaticResource Visible}}">
              <TextBlock Text="{Binding ResultScope}" TextTrimming="CharacterEllipsis" ToolTip="{Binding ResultScope}" Foreground="{StaticResource Muted}" FontSize="10" Margin="0,0,0,4" />
              <TextBlock Text="{Binding SnapshotDescription}" TextTrimming="CharacterEllipsis" ToolTip="{Binding SnapshotDescription}" Foreground="{StaticResource Accent}" FontSize="10" />
              <DockPanel Visibility="{Binding ShowFolderNavigation, Converter={StaticResource Visible}}" Margin="0,6,0,0">
                <Button Content="↑" Command="{Binding UpCommand}" Padding="12,6" ToolTip="상위 폴더" />
                <TextBlock Text="현재 경로" FontSize="10" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="12,0,8,0" />
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" ScrollChanged="BreadcrumbScrollChanged">
                  <ItemsControl x:Name="BreadcrumbTrail" ItemsSource="{Binding BreadcrumbItems}" VerticalAlignment="Center">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                          <Button Command="{Binding DataContext.NavigateBreadcrumbCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" ToolTip="{Binding Path}" Padding="9,6" Margin="0,0,2,0" Background="Transparent" BorderThickness="0" MaxWidth="220" AutomationProperties.Name="{Binding Name}">
                            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                          </Button>
                          <TextBlock Text="›" Foreground="{StaticResource Muted}" Margin="2,0,4,0" VerticalAlignment="Center">
                            <TextBlock.Style>
                              <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                <Style.Triggers>
                                  <DataTrigger Binding="{Binding IsCurrent}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                                </Style.Triggers>
                              </Style>
                            </TextBlock.Style>
                          </TextBlock>
                        </StackPanel>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </ScrollViewer>
              </DockPanel>
            </StackPanel>
            <Grid x:Name="ResultColumns" Grid.Row="1">
              <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="MapColumn">
                  <ColumnDefinition.Width>
                    <MultiBinding Converter="{StaticResource SpaceMapVisibility}" ConverterParameter="Width">
                      <Binding Path="IsMapVisible" />
                      <Binding Path="HasDetailPanel" />
                      <Binding ElementName="ResultColumns" Path="ActualWidth" />
                      <Binding Path="MapPanelWidth" RelativeSource="{RelativeSource AncestorType=Window}" />
                      <Binding Path="DetailsPanelWidth" RelativeSource="{RelativeSource AncestorType=Window}" />
                      <Binding Path="IsCleanup" />
                    </MultiBinding>
                  </ColumnDefinition.Width>
                </ColumnDefinition>
                <ColumnDefinition Width="*" MinWidth="480" />
                <ColumnDefinition x:Name="DetailsColumn">
                  <ColumnDefinition.Width>
                    <MultiBinding Converter="{StaticResource SpaceMapVisibility}" ConverterParameter="DetailsWidth">
                      <Binding Path="IsMapVisible" />
                      <Binding Path="HasDetailPanel" />
                      <Binding ElementName="ResultColumns" Path="ActualWidth" />
                      <Binding Path="MapPanelWidth" RelativeSource="{RelativeSource AncestorType=Window}" />
                      <Binding Path="DetailsPanelWidth" RelativeSource="{RelativeSource AncestorType=Window}" />
                      <Binding Path="IsCleanup" />
                    </MultiBinding>
                  </ColumnDefinition.Width>
                </ColumnDefinition>
              </Grid.ColumnDefinitions>
              <Border x:Name="SpaceMapPanel" Grid.Column="0" Style="{StaticResource Card}" Width="{Binding MapPanelWidth, RelativeSource={RelativeSource AncestorType=Window}}" HorizontalAlignment="Left" Padding="16" Margin="0,0,16,0">
                <Border.Visibility>
                  <MultiBinding Converter="{StaticResource SpaceMapVisibility}">
                    <Binding Path="IsMapVisible" />
                    <Binding Path="HasDetailPanel" />
                    <Binding ElementName="ResultColumns" Path="ActualWidth" />
                    <Binding Path="MapPanelWidth" RelativeSource="{RelativeSource AncestorType=Window}" />
                    <Binding Path="DetailsPanelWidth" RelativeSource="{RelativeSource AncestorType=Window}" />
                    <Binding Path="IsCleanup" />
                  </MultiBinding>
                </Border.Visibility>
                <Grid>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                  </Grid.RowDefinitions>
                  <StackPanel Margin="0,0,0,12">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <TextBlock Text="{Binding MapTitle}" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
                      <Border Grid.Column="1" Background="#111319" CornerRadius="8" Padding="3" Margin="8,0,0,0">
                        <StackPanel Orientation="Horizontal">
                          <Button Content="블록" Command="{Binding SetMapLayoutCommand}" CommandParameter="blocks" Tag="{Binding IsBlockMap}" Style="{StaticResource MapMode}" AutomationProperties.Name="블록 공간 구성" />
                          <Button Content="도넛" Command="{Binding SetMapLayoutCommand}" CommandParameter="donut" Tag="{Binding IsDonutMap}" Style="{StaticResource MapMode}" AutomationProperties.Name="도넛 공간 구성" />
                        </StackPanel>
                      </Border>
                    </Grid>
                    <TextBlock Text="{Binding MapHint}" Foreground="{StaticResource Muted}" FontSize="10" Margin="0,6,0,0" />
                  </StackPanel>
                  <controls:SpaceMap Grid.Row="1" Items="{Binding MapItems}" LayoutMode="{Binding MapLayout}" ItemInvoked="MapItemInvoked" MinHeight="80" />
                  <StackPanel Grid.Row="2" Margin="0,13,0,0">
                    <Border x:Name="MapFreeSpace" BorderBrush="{StaticResource Border}" BorderThickness="0,1,0,0" Padding="0,10,0,10" Visibility="{Binding ShowMapFreeSpace, Converter={StaticResource Visible}}">
                      <StackPanel>
                        <TextBlock Text="디스크 여유 공간" Foreground="{StaticResource Muted}" FontSize="11" />
                        <TextBlock Text="{Binding MapFreeSpaceText}" Foreground="{StaticResource Accent}" FontSize="16" FontWeight="SemiBold" Margin="0,4,0,0" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding MapFreeSpaceNote}" Foreground="{StaticResource Muted}" FontSize="10" Margin="0,4,0,0" TextWrapping="Wrap" />
                      </StackPanel>
                    </Border>
                    <TextBlock Text="{Binding MapBasisText}" Foreground="#768094" FontSize="10" TextWrapping="Wrap" />
                  </StackPanel>
                </Grid>
              </Border>
              <Thumb x:Name="MapResizeHandle" Grid.Column="0" HorizontalAlignment="Right" Width="16" Cursor="SizeWE" Focusable="True" DragStarted="PanelResizeStarted" DragCompleted="PanelResizeCompleted" DragDelta="MapResizeDragDelta" KeyDown="MapResizeKeyDown" ToolTip="공간 구성 너비" AutomationProperties.Name="공간 구성 너비 조절" Visibility="{Binding Visibility, ElementName=SpaceMapPanel}">
                <Thumb.Template>
                  <ControlTemplate TargetType="Thumb">
                    <Border Background="Transparent">
                      <Border x:Name="Grip" Width="2" Height="36" CornerRadius="1" Background="{StaticResource Border}" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                      <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Grip" Property="Background" Value="{StaticResource Accent}" /></Trigger>
                      <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Grip" Property="Background" Value="{StaticResource Accent}" /></Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </Thumb.Template>
              </Thumb>
              <Border Grid.Column="1" Style="{StaticResource Card}" Padding="0" ClipToBounds="True" Visibility="{Binding ShowStandardResults, Converter={StaticResource Visible}}">
                <Grid>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                  </Grid.RowDefinitions>
                  <Grid Margin="18,14,18,10">
                    <StackPanel>
                      <TextBlock x:Name="TableTitleText" Text="{Binding TableTitle}" FontWeight="SemiBold" FontSize="15" Visibility="{Binding ShowTableTitle, Converter={StaticResource Visible}}" />
                      <TextBlock Text="{Binding TableHint}" Foreground="{StaticResource Muted}" FontSize="10" Margin="0,5,0,0" Visibility="{Binding ShowTableHint, Converter={StaticResource Visible}}" />
                    </StackPanel>
                    <TextBlock Text="{Binding ResultCount}" HorizontalAlignment="Right" VerticalAlignment="Top" Foreground="{StaticResource Muted}" FontSize="11" />
                  </Grid>
                  <TextBox Grid.Row="1" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged, Delay=180}" Margin="16,0,16,12" AutomationProperties.Name="결과 검색" ToolTip="현재 목록의 이름·경로 검색">
                    <TextBox.Style>
                      <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                        <Style.Triggers>
                          <Trigger Property="Text" Value="">
                            <Setter Property="Background">
                              <Setter.Value>
                                <VisualBrush AlignmentX="Left" AlignmentY="Center" Stretch="None">
                                  <VisualBrush.Visual>
                                    <TextBlock Text="   이름 또는 경로 검색…" Foreground="#727B8F" FontSize="12" />
                                  </VisualBrush.Visual>
                                </VisualBrush>
                              </Setter.Value>
                            </Setter>
                          </Trigger>
                        </Style.Triggers>
                      </Style>
                    </TextBox.Style>
                  </TextBox>
                  <Grid Grid.Row="2">
                    <DataGrid x:Name="ResultsGrid" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ItemsSource="{Binding DisplayRows}" Sorting="ResultsSorting" SelectedItem="{Binding SelectedRow}" PreviewMouseLeftButtonDown="ResultsMouseDown" MouseDoubleClick="ResultsDoubleClick" KeyDown="ResultsKeyDown" AutomationProperties.Name="분석 결과 목록">
                      <DataGrid.Columns>
                        <DataGridTemplateColumn Header="이름" Width="*" SortMemberPath="Name">
                          <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                              <Grid>
                                <Grid.ColumnDefinitions>
                                  <ColumnDefinition Width="30" />
                                  <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Glyph}" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Foreground="#B9AAEC" FontSize="17" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                  <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" FontSize="12" ToolTip="{Binding Name}" />
                                  <TextBlock Text="{Binding Path}" Foreground="#808A9F" FontSize="10" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding Path}" />
                                </StackPanel>
                              </Grid>
                            </DataTemplate>
                          </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="크기" Binding="{Binding Size}" SortMemberPath="Bytes" Width="105" />
                        <DataGridTemplateColumn Header="전체 비율" Width="92" SortMemberPath="Share">
                          <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                              <StackPanel>
                                <TextBlock Text="{Binding ShareText}" FontSize="11" Foreground="#B7BECC" />
                                <ProgressBar Value="{Binding Share, Mode=OneWay}" Height="3" Foreground="#B29DDD" Background="#333746" BorderThickness="0" Margin="0,6,0,0" />
                              </StackPanel>
                            </DataTemplate>
                          </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                      </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock Text="항목 없음" Foreground="{StaticResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding NoRows, Converter={StaticResource Visible}}" IsHitTestVisible="False" />
                  </Grid>
                  <Border Grid.Row="3" BorderBrush="{StaticResource Border}" BorderThickness="0,1,0,0" Padding="12,10">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                      <Button Content="세부정보" Command="{Binding ShowSystemInfoCommand}" Visibility="{Binding CanShowDetails, Converter={StaticResource Visible}}" Padding="11,7" FontSize="11" Margin="0,0,8,0" />
                      <Button Content="경로 복사" Command="{Binding CopyPathCommand}" Padding="11,7" FontSize="11" Margin="0,0,8,0" />
                      <Button Content="탐색기에서 보기 ↗" Command="{Binding RevealCommand}" Padding="11,7" FontSize="11" />
                    </StackPanel>
                  </Border>
                </Grid>
              </Border>
              <ContentControl x:Name="CleanupAnalysis" Grid.Column="1" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" Visibility="{Binding ShowCleanupResults, Converter={StaticResource Visible}}">
                <ContentControl.Style>
                  <Style TargetType="ContentControl">
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding ShowCleanupResults}" Value="True">
                        <Setter Property="Content" Value="{Binding Cleanup}" />
                        <Setter Property="ContentTemplate"><Setter.Value><DataTemplate><controls:CleanupAnalysisView /></DataTemplate></Setter.Value></Setter>
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </ContentControl.Style>
              </ContentControl>
              <Thumb x:Name="DetailsResizeHandle" Grid.Column="2" HorizontalAlignment="Left" Width="16" Cursor="SizeWE" Focusable="True" Template="{Binding Template, ElementName=MapResizeHandle}" DragStarted="PanelResizeStarted" DragCompleted="PanelResizeCompleted" DragDelta="DetailsResizeDragDelta" KeyDown="DetailsResizeKeyDown" ToolTip="세부정보 너비" AutomationProperties.Name="세부정보 너비 조절" Visibility="{Binding HasDetailPanel, Converter={StaticResource Visible}}" />
              <Border x:Name="SystemInfoPanel" Grid.Column="2" Style="{StaticResource Card}" Margin="16,0,0,0" Padding="18" Visibility="{Binding HasDetailPanel, Converter={StaticResource Visible}}">
                <Grid>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                  </Grid.RowDefinitions>
                  <Grid Margin="0,0,0,15">
                    <StackPanel>
                      <TextBlock Text="세부정보" FontSize="17" FontWeight="SemiBold" />
                    </StackPanel>
                    <Button Content="✕" Command="{Binding DismissSystemInfoCommand}" HorizontalAlignment="Right" VerticalAlignment="Top" Padding="7,3" Background="Transparent" BorderThickness="0" AutomationProperties.Name="세부정보 닫기" />
                  </Grid>
                  <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Visible" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="0,0,8,0">
                      <Button Content="질문하기" Click="AskFolderClick" Visibility="{Binding HasQuestionFolder, Converter={StaticResource Visible}}" IsEnabled="{Binding IsIdle}" HorizontalAlignment="Left" Margin="0,0,0,12" />
                      <Expander x:Name="GeneralSection" Header="General" IsExpanded="{Binding GeneralExpanded, Mode=TwoWay}" Foreground="{StaticResource Text}" HorizontalContentAlignment="Stretch" FontSize="13">
                        <StackPanel Margin="0,14,0,0" Visibility="{Binding HasDetails, Converter={StaticResource Visible}}">
                          <ItemsControl x:Name="DetailFields" ItemsSource="{Binding Details}">
                            <ItemsControl.ItemsPanel>
                              <ItemsPanelTemplate><controls:ResponsiveDetailsPanel /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                              <DataTemplate>
                                <StackPanel Margin="0,0,0,13">
                                  <TextBlock Text="{Binding Label}" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,0,0,4" />
                                  <TextBlock Text="{Binding Value}" TextWrapping="Wrap" FontSize="12" />
                                </StackPanel>
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                        </StackPanel>
                      </Expander>
                      <Border BorderBrush="{StaticResource Border}" BorderThickness="0,1,0,0" Padding="0,16,0,0" Margin="0,16,0,0" Visibility="{Binding HasSystemInfo, Converter={StaticResource Visible}}">
                        <Expander x:Name="SystemInfoSection" Header="Windows 파일 설명" IsExpanded="{Binding SystemInfoExpanded, Mode=TwoWay}" Foreground="{StaticResource Text}" HorizontalContentAlignment="Stretch" FontSize="13">
                        <StackPanel Margin="0,14,0,0">
                        <TextBlock Text="{Binding SystemInfo.Title}" TextWrapping="Wrap" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource Accent}" />
                        <controls:ResponsiveDetailsPanel>
                        <StackPanel>
                        <TextBlock Text="용도" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,18,0,5" />
                        <TextBlock Text="{Binding SystemInfo.Purpose}" TextWrapping="Wrap" FontSize="12" LineHeight="20" />
                        </StackPanel>
                        <StackPanel>
                        <TextBlock Text="관리 주체" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,17,0,5" />
                        <TextBlock Text="{Binding SystemInfo.ManagedBy}" TextWrapping="Wrap" FontSize="12" LineHeight="20" />
                        </StackPanel>
                        <StackPanel>
                        <TextBlock Text="필요성" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,17,0,5" />
                        <TextBlock Text="{Binding SystemInfo.Necessity}" TextWrapping="Wrap" FontSize="12" LineHeight="20" />
                        </StackPanel>
                        <StackPanel>
                        <TextBlock Text="정리 방법" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,17,0,5" />
                        <TextBlock Text="{Binding SystemInfo.CleanupAdvice}" TextWrapping="Wrap" FontSize="12" LineHeight="20" />
                        </StackPanel>
                        </controls:ResponsiveDetailsPanel>
                        <Border Background="#252333" CornerRadius="7" Padding="10" Margin="0,18,0,0">
                          <TextBlock Text="{Binding SystemInfo.MatchBasis}" TextWrapping="Wrap" Foreground="{StaticResource Muted}" FontSize="10" LineHeight="17" />
                        </Border>
                        <Button Content="Microsoft 문서 ↗" Command="{Binding OpenSystemHelpCommand}" Margin="0,15,0,0" Padding="12,9" FontSize="11" />
                        </StackPanel>
                        </Expander>
                      </Border>
                      <Border BorderBrush="{StaticResource Border}" BorderThickness="0,1,0,0" Padding="0,16,0,0" Margin="0,16,0,0" Visibility="{Binding HasMediaInfo, Converter={StaticResource Visible}}">
                        <Expander x:Name="MediaInfoSection" Header="MediaInfo" IsExpanded="{Binding MediaInfoExpanded, Mode=TwoWay}" Foreground="{StaticResource Text}" HorizontalContentAlignment="Stretch" FontSize="13">
                          <StackPanel Margin="0,14,0,0">
                            <TextBlock Text="{Binding MediaInfoStatus}" Foreground="{StaticResource Muted}" TextWrapping="Wrap" FontSize="11" />
                            <ItemsControl ItemsSource="{Binding MediaInfoGroups}">
                              <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                  <StackPanel Margin="0,0,0,8">
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Foreground="{StaticResource Accent}" Margin="0,8,0,12" />
                                    <ItemsControl ItemsSource="{Binding Fields}">
                                      <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><controls:ResponsiveDetailsPanel /></ItemsPanelTemplate>
                                      </ItemsControl.ItemsPanel>
                                      <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                          <StackPanel Margin="0,0,0,13">
                                            <TextBlock Text="{Binding Label}" Foreground="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,4" />
                                            <TextBlock Text="{Binding Value}" TextWrapping="Wrap" FontSize="12" />
                                          </StackPanel>
                                        </DataTemplate>
                                      </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                  </StackPanel>
                                </DataTemplate>
                              </ItemsControl.ItemTemplate>
                            </ItemsControl>
                          </StackPanel>
                        </Expander>
                      </Border>
                      <Border x:Name="PreviewSection" BorderBrush="{StaticResource Border}" BorderThickness="0,1,0,0" Padding="0,16,0,0" Margin="0,16,0,0" Visibility="{Binding CanPreview, Converter={StaticResource Visible}}">
                        <Expander x:Name="PreviewExpander" Header="미리보기" IsExpanded="{Binding PreviewExpanded, Mode=TwoWay}" Foreground="{StaticResource Text}" HorizontalContentAlignment="Stretch" FontSize="13">
                        <StackPanel Margin="0,14,0,0">
                          <controls:FilePreviewControl x:Name="ItemPreview" Preview="{Binding Preview}" Margin="0,0,0,8" />
                          <StackPanel x:Name="PreviewPageNavigation" Orientation="Horizontal" HorizontalAlignment="Center" Visibility="{Binding HasPreviewPages, Converter={StaticResource Visible}}">
                            <Button Content="이전 페이지" Command="{Binding PreviousPreviewPageCommand}" Padding="8,6" />
                            <TextBlock Text="{Binding PreviewPageLabel}" VerticalAlignment="Center" Margin="10,0" />
                            <Button Content="다음 페이지" Command="{Binding NextPreviewPageCommand}" Padding="8,6" />
                          </StackPanel>
                        </StackPanel>
                        </Expander>
                      </Border>
                    </StackPanel>
                  </ScrollViewer>
                </Grid>
              </Border>
            </Grid>
          </Grid>
          <Border Style="{StaticResource Card}" Visibility="{Binding ShowEmpty, Converter={StaticResource Visible}}" Background="#171A22">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
              <TextBlock Text="분석 결과 없음" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" />
              <TextBlock Text="드라이브·폴더별 용량 분석" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,10,0,0" HorizontalAlignment="Center" />
            </StackPanel>
          </Border>
        </Grid>
        <Grid Grid.Row="4" Margin="0,10,0,0">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <ProgressBar Height="2" IsIndeterminate="{Binding IsBusy}" Visibility="{Binding IsBusy, Converter={StaticResource Visible}}" Foreground="{StaticResource Accent}" Background="#282331" BorderThickness="0" />
          <StackPanel Grid.Row="1" VerticalAlignment="Center">
            <TextBlock x:Name="FooterStatusText" Text="{Binding Status}" FontSize="11" Foreground="#C0C6D2" Visibility="{Binding ShowStatus, Converter={StaticResource Visible}}" />
            <TextBlock Text="{Binding CurrentPath}" FontSize="10" Foreground="#7D879B" Margin="0,5,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding CurrentPath}">
              <TextBlock.Style>
                <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                  <Style.Triggers>
                    <Trigger Property="Text" Value="">
                      <Setter Property="Visibility" Value="Collapsed" />
                    </Trigger>
                  </Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>
          </StackPanel>
        </Grid>
      </Grid>
    </Grid>
  </Border>
</Window>
